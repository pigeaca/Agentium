+# Inline link targets: <angle brackets> (may contain spaces) or a bare target, then an optional "title", 'title' or (title).
+LINK_TARGET = re.compile(r"""\]\((<[^>\n]*>|[^)\s]*)(?:\s+(?:"[^"\n]*"|'[^'\n]*'|\([^)\n]*\)))?\s*\)""")
+
+
 def markdown_links(path: Path) -> list[str]:
-    return re.findall(r"\]\(([^)#\s]+)(?:#[^)]*)?\)", path.read_text())
+    """Link and image targets without their #anchor; anchor-only links are skipped."""
+    links = []
+    for target in LINK_TARGET.findall(path.read_text()):
+        target = target[1:-1] if target.startswith("<") else target
+        target = target.split("#", 1)[0]
+        if target:
+            links.append(target)
+    return links
 
 
