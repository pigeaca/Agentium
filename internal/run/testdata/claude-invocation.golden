-- env
PATH=/usr/bin:/bin
HOME=<T>/home
USER=u
LOGNAME=u
SHELL=/bin/zsh
TMPDIR=/golden/tmp
LANG=en_US.UTF-8
LC_ALL=C
TERM=xterm
TZ=UTC
GOPATH=/golden/go
GOPROXY=https://proxy.golang.org
JAVA_HOME=/golden/jdk
CARGO_HOME=/golden/cargo
RUSTC_WRAPPER=sccache
XDG_CONFIG_HOME=/golden/xdg
NODE_OPTIONS=--max-old-space-size=4096
HOMEBREW_PREFIX=/opt/homebrew
HTTPS_PROXY=http://proxy:3128
SSL_CERT_FILE=/golden/certs.pem
XDG_RUNTIME_DIR=/golden/run
GOFLAGS=-mod=mod -buildvcs=false
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
DISABLE_AUTOUPDATER=1
ENABLE_CLAUDEAI_MCP_SERVERS=false
GOCACHE=<T>/data/workspaces/<ID>/go-build
CLAUDE_CODE_TMPDIR=<RUNTEMP>
CLAUDE_CONFIG_DIR=<T>/home/.claude-work
== root task, API key, claude-sonnet-5, effort low, no cap
-- working folder
<T>/data/workspaces/<ID>/repo
-- session folder
<T>/data/workspaces/<ID>/config/projects/<T-AS-SESSION-NAME>-data-workspaces-<ID>-repo
-- args
-p
"Make the value new.\n\nYou are working in this task's own checkout of the repository. Make the change here, in the working tree. Do not commit, push, open a pull request, or create branches or worktrees. When you are done, reply with a short summary of what you changed and how you verified it."
--model
claude-sonnet-5
--output-format
stream-json
--verbose
--permission-mode
acceptEdits
--permission-prompts
none
--no-session-persistence
--setting-sources
project
--strict-mcp-config
--disallowedTools
WebSearch,WebFetch,Artifact,DesignSync,CronCreate,CronDelete,ScheduleWakeup,Workflow,SendMessage,EnterWorktree,ExitWorktree,ArtifactComments,ArtifactData,Monitor,PushNotification,RemoteTrigger
--settings
<the settings below>
--effort
low
