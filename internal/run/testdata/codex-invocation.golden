  "<T>/home/.config/uv/uv.toml"="deny"
  "<T>/home/.local/share/uv/credentials"="deny"
  "<T>/home/.config/pypoetry/auth.toml"="deny"
  "<T>/home/Library/Application Support/pypoetry/auth.toml"="deny"
