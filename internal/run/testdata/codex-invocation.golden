  "/private/etc/xdg/pip/pip.conf"="deny"
  "/etc/uv/uv.toml"="deny"
  "/private/etc/uv/uv.toml"="deny"
  "/Library/Application Support/pip/pip.conf"="deny"
  "<T>/home/.npm"="deny"
  "<T>/home/Library/pnpm/store"="deny"
  "<T>/home/.local/share/pnpm/store"="deny"
  "<T>/data/deps/1/gradle"="deny"
  "<T>/data/deps/1/build-cache"="deny"
  "<T>/data/deps/1/uv-cache"="deny"
  "<T>/data/deps/1/pip-cache"="deny"
  "<T>/data/deps/1/py-resolve"="deny"
  "/tmp/claude-<UID>"="deny"
  "/private/tmp/claude-<UID>"="deny"
  "/tmp/claude"="deny"
  "/private/tmp/claude"="deny"
  "/tmp/cc-socks"="deny"
  "/private/tmp/cc-socks"="deny"
