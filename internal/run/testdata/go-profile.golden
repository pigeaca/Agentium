== BuildEnv
GOCACHE=<CACHE>/go-build
GOCACHEPROG=
TMPDIR=<CACHE>/tmp
GOTMPDIR=<CACHE>/tmp
XDG_CACHE_HOME=<CACHE>/xdg
== discovery: go.mod only
["go test ./..."]
== discovery: go.mod, Makefile with test, harness
["go test ./..." "make test" "python3 scripts/harness.py check ci"]
== discovery: go.mod in a subfolder only
[]
== discovery: every tool discovery knows
["go test ./..." "yarn test" "python3 -m pytest" "make test" "python3 scripts/harness.py check ci"]
== checkFiles ["go test ./..."]
scripts []
configs ["go.mod"]
== checkFiles ["go vet ./... && go test -race -count=1 ./pkg/..."]
scripts []
configs ["go.mod"]
== checkFiles ["GOFLAGS=-mod=mod go test ./..."]
scripts []
configs ["go.mod"]
== checkFiles ["gofmt -l ."]
scripts []
configs []
== checkFiles ["make test"]
scripts []
configs ["GNUmakefile" "Makefile"]
== checkFiles ["./scripts/check.sh"]
scripts ["scripts/check.sh"]
configs []
== checkFiles ["sh scripts/check.sh go"]
scripts ["scripts/check.sh"]
configs ["go.mod"]
== checkFiles ["bash test.sh"]
scripts ["test.sh"]
configs []
== checkFiles ["cargo test"]
scripts []
configs ["Cargo.toml"]
== checkFiles ["go test ./..." "make lint" "npx jest"]
scripts []
configs ["GNUmakefile" "Makefile" "go.mod" "jest.config.js"]
== checkFiles ["golangci-lint run" "go-junit-report"]
scripts []
configs ["go.mod"]
== checkFiles ["python3 -m pytest -q"]
